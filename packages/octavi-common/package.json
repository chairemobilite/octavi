{
  "engines": {
    "node": ">=24.0.0"
  },
  "name": "octavi-common",
  "version": "0.5.0",
  "description": "Common types and utilities for the Octavi application",
  "repository": "github.com/chairemobilite/octavi",
  "license": "MIT",
  "scripts": {
    "clean": "rimraf lib/",
    "compile": "tsc",
    "compile:dev": "tsc -w",
    "test": "echo 'cross-env NODE_ENV=test jest --config=jest.config.js'",
    "test:unit": "cross-env NODE_ENV=test jest --config=jest.config.js",
    "test:sequential": "echo 'no tests to run for this workspace'",
    "test:ui": "echo 'no tests to run for this workspace'",
    "lint": "eslint .",
    "format": "prettier --write --log-level warn \"./src/**/*.{ts,tsx}\" && eslint --fix --quiet \"./src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "chaire-lib-common": "workspace:^"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "eslint-plugin-n": "^18.5.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
